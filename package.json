{"dependencies":{"fastify":"^5.3.0","nodemailer":"^6.9.0","pg":"^8.13.0"},"description":"PR triage for agent fleets: clusters agent PRs, risk-scores them deterministically, and issues one daily digest a human can work through.","devDependencies":{"@types/node":"^22.10.0","@types/nodemailer":"^6.4.0","@types/pg":"^8.11.0","@types/react":"^19.0.0","@types/react-dom":"^19.0.0","@vitejs/plugin-react":"^4.4.0","eslint":"^9.18.0","react":"^19.0.0","react-dom":"^19.0.0","typescript":"^5.7.0","typescript-eslint":"^8.24.0","vite":"^6.0.0"},"engines":{"node":">=22"},"license":"Apache-2.0","main":"dist/server/index.js","name":"headgate","private":true,"scripts":{"build":"tsc -p tsconfig.json && npm run build:client","build:client":"vite build --config client/vite.config.ts","build:server":"tsc -p tsconfig.json && mkdir -p dist/server/db && cp src/server/db/schema.sql dist/server/db/schema.sql","db:reset":"node scripts/reset-db.mjs","dev":"node dist/server/index.js","lint":"eslint src && node scripts/check-artifacts.mjs","smoke":"node scripts/smoke.mjs","start":"node dist/server/index.js","test":"npm run build:server && node --test --test-concurrency=1 dist/server/*.test.js","typecheck":"tsc -p tsconfig.json --noEmit"},"type":"commonjs","version":"0.1.0"}