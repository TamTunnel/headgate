# Headgate — local development defaults. Copy to .env and fill in.
# Never commit a real .env: secrets live here, not in git.
DATABASE_URL=postgres://headgate:headgate-dev@127.0.0.1:5432/headgate
# Operator token for every /api/* route except /api/health (F1).
# Required in production; in development it defaults to a dev-only value.
ADMIN_TOKEN=
GITHUB_WEBHOOK_SECRET=headgate-dev-webhook-secret
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_SLUG=headgate
BASE_URL=http://localhost:3000
DIGEST_HOUR=9
RETENTION_DAYS=30
AUDIT_LOG_PATH=data/audit.jsonl
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
# DIGEST_RECIPIENTS=
